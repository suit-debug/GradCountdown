<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>GradCountdown</AssemblyName>
    <RootNamespace>GradCountdown</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>GradCountdown</Product>
    <AssemblyTitle>GradCountdown</AssemblyTitle>
    <Company>suit-debug</Company>
    <Authors>suit-debug</Authors>
    <Copyright>Copyright (c) 2026 suit-debug</Copyright>
    <Description>A tiny Windows desktop widget counting down the days of graduate school.</Description>
  </PropertyGroup>

  <!-- Release 发布不携带 pdb，保持 publish 目录干净 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
