<Window x:Class="GradCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GradCountdown.ViewModels"
        mc:Ignorable="d"
        Title="GradCountdown"
        Icon="Resources/app.ico"
        SizeToContent="WidthAndHeight"
        WindowState="Normal"
        Visibility="Visible"
        Opacity="{Binding UiOpacity}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding IsTopmost}"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- 扁平轻量按钮样式 -->
        <Style x:Key="FlatActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 现代化 Slider 样式 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#2E8B99"/>
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>

        <!-- 紧凑 CheckBox 样式 -->
        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
    </Window.Resources>

    <!-- 外层 Grid 提供 DropShadow 空间与 ScaleTransform 缩放 -->
    <Grid Margin="12">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>

        <!-- 卡片主体容器 (固定基准尺寸 290 x 160) -->
        <Border x:Name="CardBorder"
                Width="290"
                Height="160"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#EDF1F5"
                BorderThickness="1"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                MouseMove="Window_MouseMove"
                MouseLeftButtonUp="Window_MouseLeftButtonUp"
                Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  Color="#1E293B"
                                  Opacity="0.10"
                                  ShadowDepth="4"
                                  Direction="270"/>
            </Border.Effect>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="切换模式 (单击卡片亦可)" Click="ToggleMode_Click"/>
                    <MenuItem Header="缩放与透明度..." Click="OpenSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="锁定位置" IsCheckable="True" IsChecked="{Binding LockPosition, Mode=TwoWay}"/>
                    <MenuItem Header="始终置顶" IsCheckable="True" IsChecked="{Binding IsTopmost, Mode=TwoWay}"/>
                    <MenuItem Header="开机自启" IsCheckable="True" IsChecked="{Binding IsAutoStart, Mode=TwoWay}"/>
                    <Separator/>
                    <MenuItem Header="隐藏到托盘" Click="Hide_Click"/>
                    <MenuItem Header="退出程序" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 顶部栏：图标 Badge + 标题 + 更多按钮 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 Badge (青蓝色圆角矩形) -->
                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="#32889A"
                            VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 状态 A: 学位帽图标 -->
                            <Path Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3z M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"
                                  Fill="#FFFFFF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsGraduationMode, Converter={StaticResource BoolToVisConverter}}"/>

                            <!-- 状态 B: 书本图标 -->
                            <Path Data="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.65 1 5.75V19c0 .55.45 1 1 1 .1 0 .2 0 .3-.05C3.7 19.45 5.3 19 7 19c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.4.2.75-.1.75-.5V5.75c-.5-.35-1.6-.75-2.5-.75zM11 17.5c-1.2-.7-2.7-1-4-1-1.3 0-2.8.3-4 1V7c1.2-.7 2.7-1 4-1 1.3 0 2.8.3 4 1v10.5zm10 0c-1.2-.7-2.7-1-4-1-1.3 0-2.8.3-4 1V7c1.2-.7 2.7-1 4-1 1.3 0 2.8.3 4 1v10.5z"
                                  Fill="#FFFFFF"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsGraduationMode, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- 标题文本 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding HeaderTitle}"
                               Foreground="#1D6677"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                    <!-- 右侧三点更多按钮 -->
                    <Button x:Name="MoreButton"
                            Grid.Column="2"
                            Style="{StaticResource FlatActionBtn}"
                            Click="MoreButton_Click"
                            Padding="6,2,6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="•••"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                    </Button>

                    <!-- 浮动设置弹窗 (Popup) -->
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=MoreButton}"
                           Placement="Bottom"
                           HorizontalOffset="-170"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="230"
                                Padding="12,10,12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Color="#0F172A"
                                                  Opacity="0.14"
                                                  ShadowDepth="3"
                                                  Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- 1. 界面缩放 -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="界面缩放"
                                               Foreground="#334155"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UiScalePercentageText}"
                                               Foreground="#2E8B99"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}"
                                        Minimum="0.60"
                                        Maximum="1.30"
                                        SmallChange="0.05"
                                        LargeChange="0.10"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding UiScale, Mode=TwoWay}"
                                        Margin="0,0,0,8"/>

                                <!-- 2. 界面透明度 -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="界面透明度"
                                               Foreground="#334155"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UiOpacityPercentageText}"
                                               Foreground="#2E8B99"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}"
                                        Minimum="0.60"
                                        Maximum="1.00"
                                        SmallChange="0.05"
                                        LargeChange="0.10"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding UiOpacity, Mode=TwoWay}"
                                        Margin="0,0,0,8"/>

                                <!-- 3. 开关选项 -->
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Style="{StaticResource CompactCheckBox}"
                                              Content="锁定位置"
                                              IsChecked="{Binding LockPosition, Mode=TwoWay}"/>
                                    <CheckBox Style="{StaticResource CompactCheckBox}"
                                              Content="始终置顶"
                                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"/>
                                    <CheckBox Style="{StaticResource CompactCheckBox}"
                                              Content="开机自启"
                                              IsChecked="{Binding IsAutoStart, Mode=TwoWay}"/>
                                </WrapPanel>

                                <!-- 4. 重置操作按钮 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="重置大小 (85%)"
                                            FontSize="10.5"
                                            Foreground="#64748B"
                                            Background="#F1F5F9"
                                            Padding="4,3,4,3"
                                            Margin="0,0,3,0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="ResetScale_Click"/>
                                    <Button Grid.Column="1"
                                            Content="重置透明度"
                                            FontSize="10.5"
                                            Foreground="#64748B"
                                            Background="#F1F5F9"
                                            Padding="4,3,4,3"
                                            Margin="3,0,0,0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="ResetOpacity_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 2. 中间：超大数字/状态文本显示 (紧凑居中) -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayDays}"
                               FontSize="{Binding DisplayFontSize}"
                               Foreground="#222D39"
                               FontWeight="Bold"
                               FontFamily="Segoe UI, Microsoft YaHei UI"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-3,0,1"/>
                </Grid>

                <!-- 3. 底部栏：日期信息 + 日历图标 -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding FooterText}"
                               Foreground="#64748B"
                               FontSize="12.5"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               VerticalAlignment="Center"/>

                    <!-- 日历轮廓图标 -->
                    <Path Grid.Column="1"
                          Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z M7 11h5v5H7z"
                          Fill="#94A3B8"
                          Width="13.5"
                          Height="13.5"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
